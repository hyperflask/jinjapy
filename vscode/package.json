{
  "name": "jinjapy-language-support",
  "displayName": "Jinjapy Language Support",
  "description": "Jinjapy Language Support",
  "publisher": "hyperflask",
  "repository": {
    "url": "https://github.com/hyperflask/jinjapy"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "jinjapy",
      "aliases": ["Jinjapy", "jinjapy"],
      "extensions": [".jpy"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "jinjapy",
      "scopeName": "source.jinjapy",
      "path": "./syntaxes/jinjapy.tmLanguage.json"
    }]
  }
}
